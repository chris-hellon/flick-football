# systemd unit for Flick Football. setup-droplet.sh installs it as
# /etc/systemd/system/flick-football.service with __PORT__ filled in.
[Unit]
Description=Flick Football (ASP.NET Core: game site and online hub)
After=network.target

[Service]
Type=simple
User=flickfootball
Group=flickfootball
WorkingDirectory=/var/www/flick-football
ExecStart=/var/www/flick-football/FlickFootball.Server
Restart=always
RestartSec=5
# ASP.NET Core shuts down cleanly on SIGINT.
KillSignal=SIGINT
TimeoutStopSec=15
SyslogIdentifier=flick-football

Environment=ASPNETCORE_ENVIRONMENT=Production
# Loopback only: Nginx is the only way in.
Environment=ASPNETCORE_URLS=http://127.0.0.1:__PORT__
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# A good neighbour on a shared droplet: hard memory and CPU caps.
MemoryMax=300M
CPUQuota=50%
TasksMax=200

# Hardening: read-only system, no home directories, no privilege changes.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
